#!/bin/bash
LED="/sys/class/leds/tpacpi::power/brightness"
STATE_FILE="/tmp/typelight-time"
COUNT_FILE="$HOME/.cache/typelight-count"
POS_FILE="/tmp/typelight-pos"
COLOR_FILE="/tmp/typelight-color"
LOCK_FILE="/tmp/typelight.lock"
KEYBOARD=$(ls /dev/input/by-path/*kbd* 2>/dev/null | head -1)

[ -z "$KEYBOARD" ] && exit 1

exec 200>"$LOCK_FILE"
flock -n 200 || exit 0

cleanup() {
    echo 0 > "$LED"
    rm -f "$STATE_FILE"
    flock -u 200
    rm -f "$LOCK_FILE"
    exit 0
}

trap cleanup INT TERM EXIT

mkdir -p "$HOME/.cache"
[ ! -f "$COUNT_FILE" ] && echo 0 > "$COUNT_FILE"

evtest "$KEYBOARD" 2>/dev/null | grep --line-buffered "EV_KEY" | while read -r line; do
    if [[ "$line" == *"value 1"* ]]; then
        echo 255 > "$LED"
        sleep 0.03
        echo 0 > "$LED"

        date +%s%N > "$STATE_FILE"
        count=$(cat "$COUNT_FILE" 2>/dev/null || echo 0)
        echo $((count + 1)) > "$COUNT_FILE"
        pos=$(cat "$POS_FILE" 2>/dev/null || echo 0)
        echo $((pos + 1)) > "$POS_FILE"
        color=$(cat "$COLOR_FILE" 2>/dev/null || echo 0)
        echo $((color + 1)) > "$COLOR_FILE"
    fi
done